# ===========================================
# VÉRTICE GASTRONÓMICO - Variables de Entorno
# ===========================================
# Copia este archivo como .env y configura tus valores

# ============================================
# GENERAL
# ============================================
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
API_KEY=your-api-key-here

# ============================================
# BASE DE DATOS - PostgreSQL
# ============================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/vertice_gastronomico?schema=public"

# ============================================
# REDIS - Cache y Sesiones
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# AUTENTICACIÓN - JWT
# ============================================
JWT_SECRET=tu-secret-key-muy-segura-cambiar-en-produccion
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# AI PROVIDERS
# ============================================
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...
GOOGLE_AI_API_KEY=AI...

# ============================================
# STRIPE - Pagos
# ============================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ============================================
# EMAIL - SMTP
# ============================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=SG...
FROM_EMAIL=Vértice Gastronómico <noreply@tudominio.com>

# ============================================
# TWILIO - SMS y WhatsApp
# ============================================
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15005550006
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ============================================
# SENTRY - Monitoreo de Errores
# ============================================
SENTRY_DSN=https://...@o...ingest.sentry.io/...
APP_VERSION=1.0.0
LOG_LEVEL=info

# ============================================
# CONFIGURACIÓN ESPECÍFICA DE MÉXICO
# ============================================
DEFAULT_TIMEZONE=America/Mexico_City
DEFAULT_CURRENCY=MXN
DEFAULT_LANGUAGE=es
TAX_RATE=0.16
